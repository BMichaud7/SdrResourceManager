<?xml version="1.0" encoding="UTF-8"?>
<!--
  SDR Controller — TEST / MOCK configuration
  ─────────────────────────────────────────────────────────────────────────
  Uses driver="null" which is a SoapySDR built-in loopback/test driver.
  No real hardware required. The controller will open these "devices",
  accept AMQP requests, perform all scheduling logic, and attempt streams.
  Stream open will fail gracefully; scheduler / codec / AMQP flow all work.

  Broker URL points to the ActiveMQ Artemis container in docker-compose /
  podman-compose (service name: activemq, port 5672 AMQP).
-->
<sdr_controller version="2.0">

  <broker>
    <!-- In podman-compose, activemq hostname resolves via the pod network -->
    <url>amqp://activemq:5672</url>
    <username>sdr_ctrl</username>
    <password>sdr_test_pw</password>
    <request_queue>sdr.task.request</request_queue>
    <response_queue>sdr.task.response</response_queue>
    <status_topic>sdr.status</status_topic>
    <health_topic>sdr.health</health_topic>
    <reconnect_interval_sec>3</reconnect_interval_sec>
    <max_reconnect_interval_sec>15</max_reconnect_interval_sec>
    <send_queue_depth>256</send_queue_depth>
  </broker>

  <policy>
    <max_concurrent_tasks>32</max_concurrent_tasks>
    <guard_band_hz>200000</guard_band_hz>
    <usable_bw_fraction>0.80</usable_bw_fraction>
    <default_task_timeout_ms>60000</default_task_timeout_ms>
    <scheduler_tick_ms>200</scheduler_tick_ms>
    <watchdog_tick_ms>500</watchdog_tick_ms>
    <udp_port_pool_start>30000</udp_port_pool_start>
    <udp_port_pool_end>30099</udp_port_pool_end>
    <!-- Small packets for loopback testing — fit in standard MTU -->
    <iq_packet_samples>128</iq_packet_samples>
    <retune_conflict_policy>REJECT_NEW</retune_conflict_policy>
    <heartbeat_interval_ms>10000</heartbeat_interval_ms>
  </policy>

  <devices>

    <!-- Mock device 0: SoapySDR "null" driver — always available, no HW -->
    <device id="mock-0">
      <driver>null</driver>
      <uri>null</uri>
      <label>Mock AD9361 Unit 0 (null driver)</label>
      <streaming_source_ip>127.0.0.1</streaming_source_ip>
      <coherency_group>test-group-0</coherency_group>
      <shared_lo>true</shared_lo>
      <capabilities>
        <rx_channels>2</rx_channels>
        <tx_channels>2</tx_channels>
        <freq_min_hz>70000000</freq_min_hz>
        <freq_max_hz>6000000000</freq_max_hz>
        <bandwidth_max_hz>56000000</bandwidth_max_hz>
        <sample_rate_max_sps>61440000</sample_rate_max_sps>
        <rx_gain_min_db>-3</rx_gain_min_db>
        <rx_gain_max_db>71</rx_gain_max_db>
        <tx_atten_min_db>0</tx_atten_min_db>
        <tx_atten_max_db>89</tx_atten_max_db>
      </capabilities>
    </device>

    <!-- Mock device 1 -->
    <device id="mock-1">
      <driver>null</driver>
      <uri>null</uri>
      <label>Mock AD9361 Unit 1 (null driver)</label>
      <streaming_source_ip>127.0.0.1</streaming_source_ip>
      <coherency_group>test-group-0</coherency_group>
      <shared_lo>true</shared_lo>
      <capabilities>
        <rx_channels>2</rx_channels>
        <tx_channels>2</tx_channels>
        <freq_min_hz>70000000</freq_min_hz>
        <freq_max_hz>6000000000</freq_max_hz>
        <bandwidth_max_hz>56000000</bandwidth_max_hz>
        <sample_rate_max_sps>61440000</sample_rate_max_sps>
        <rx_gain_min_db>-3</rx_gain_min_db>
        <rx_gain_max_db>71</rx_gain_max_db>
        <tx_atten_min_db>0</tx_atten_min_db>
        <tx_atten_max_db>89</tx_atten_max_db>
      </capabilities>
    </device>

  </devices>

</sdr_controller>
