<?xml version="1.0" encoding="UTF-8"?>
<!--
  SDR Acquisition — Spectrum Scanner Configuration
  ─────────────────────────────────────────────────────────────────────────
  Build:  cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build
  Run:    ./build/sdr_acquisition config/scanner.xml
  DB:     psql -U sdr -d sdr_scanner -f schema/init.sql   (run once first)
-->
<sdr_acquisition version="1.0">

  <!-- Unique name for this scanner instance — appears in DB and AMQP messages -->
  <scanner_id>scanner-0</scanner_id>

  <!-- ── AMQP broker ────────────────────────────────────────────────────── -->
  <!-- Downstream apps subscribe to detection_topic to receive RF detections -->
  <amqp>
    <url>amqp://localhost:5672</url>
    <username>scanner</username>
    <password>CHANGE_ME</password>
    <detection_topic>rf.detections</detection_topic>
    <reconnect_interval_sec>5</reconnect_interval_sec>
  </amqp>

  <!-- ── PostgreSQL ────────────────────────────────────────────────────── -->
  <database>
    <host>localhost</host>
    <port>5432</port>
    <name>sdr_scanner</name>
    <user>sdr</user>
    <password>CHANGE_ME</password>
  </database>

  <!-- ── SDR hardware ──────────────────────────────────────────────────── -->
  <device>
    <!-- driver: "remote" for SoapySDR Remote over network (recommended),
                 "rtlsdr" / "hackrf" / "plutosdr" for direct USB -->
    <driver>remote</driver>
    <uri>soapy://192.168.1.100:55132</uri>

    <!-- Number of RX channels to open.
         If shared_lo=false (e.g. USRP B210, HackRF) each channel can tune
         to a different frequency → sweep is rx_channels× faster.
         If shared_lo=true (e.g. PlutoSDR AD9361, LimeSDR MIMO) all channels
         see the same spectrum; multiple channels improve SNR by averaging. -->
    <rx_channels>2</rx_channels>
    <sample_rate_sps>10000000</sample_rate_sps>  <!-- 10 MSPS -->
    <rx_gain_db>40</rx_gain_db>

    <!-- Set to true for devices where all RX channels share one LO
         (AD9361 on PlutoSDR, LimeSDR USB/Mini). Set to false for devices
         with independent per-channel LOs (USRP B200/B210, dual RTL-SDR). -->
    <shared_lo>false</shared_lo>
  </device>

  <!-- ── Sweep parameters ───────────────────────────────────────────────── -->
  <sweep>
    <!-- Frequency range to scan continuously (Hz) -->
    <start_hz>70000000</start_hz>       <!-- 70 MHz  (AD9361 lower limit) -->
    <stop_hz>1000000000</stop_hz>       <!-- 1 GHz   (adjust to your interest) -->

    <!-- Samples captured per dwell position (must be >= fft_size) -->
    <dwell_samples>4096</dwell_samples>

    <!-- FFT size (power of 2, >= 64).  Larger = finer frequency resolution.
         Frequency resolution = sample_rate / fft_size.
         At 10 MSPS, fft_size=4096 → ~2.4 kHz/bin. -->
    <fft_size>4096</fft_size>

    <!-- Fraction of FFT bandwidth considered usable (the rest is roll-off).
         0.80 is safe for most SDRs. Reduce if you see edge artefacts. -->
    <usable_bw_fraction>0.80</usable_bw_fraction>

    <!-- Signal must exceed this many dB above the per-dwell noise floor
         to be reported. Higher = fewer false positives, may miss weak signals. -->
    <threshold_db>10.0</threshold_db>

    <!-- Minimum signal bandwidth to report (Hz). Filters narrow spurs. -->
    <min_signal_bw_hz>2500</min_signal_bw_hz>

    <!-- Samples discarded after retuning, to let the LO and DC-offset
         correction settle before capturing. 512 samples ≈ 50 µs at 10 MSPS. -->
    <settle_samples>512</settle_samples>
  </sweep>

</sdr_acquisition>
