[Unit]
Description=ActiveMQ Artemis AMQP 1.0 Broker (container)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s

# Broker credentials — written by setup.sh, never commit this file
# Format:  ARTEMIS_USER=<username>
#          ARTEMIS_PASSWORD=<password>
EnvironmentFile=/etc/sdr-controller/broker.env

# Change /usr/bin/podman to /usr/bin/docker if using Docker instead.
# setup.sh patches this automatically.
ExecStartPre=-/usr/bin/podman rm -f activemq-artemis
ExecStart=/usr/bin/podman run \
    --name activemq-artemis \
    --rm \
    -p 5672:5672 \
    -p 8161:8161 \
    -e ARTEMIS_USER \
    -e ARTEMIS_PASSWORD \
    apache/activemq-artemis:2.36.0
ExecStop=/usr/bin/podman stop -t 20 activemq-artemis

StandardOutput=journal
StandardError=journal
SyslogIdentifier=activemq-artemis

[Install]
WantedBy=multi-user.target
