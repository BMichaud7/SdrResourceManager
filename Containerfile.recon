# ════════════════════════════════════════════════════════════════════════
#  Containerfile.recon — OpenRFStack recon image
#
#  Extends openrfstack-pi4 (same minimal stack: qdrouterd, sdr_controller,
#  sdr_acquisition, optional GPS) and adds sdr_recon.py, activated via
#  ENABLE_RECON=1 in the shared entrypoint.
#
#  Build (pi4 image must exist first):
#    podman build -f SdrResourceManager/Containerfile.pi4 \
#                 -t openrfstack-pi4:latest --platform linux/arm64 .
#    podman build -f SdrResourceManager/Containerfile.recon \
#                 -t openrfstack-recon:latest --platform linux/arm64 .
#
#  Run:
#    podman compose -f SdrResourceManager/compose.recon.yml up -d
# ════════════════════════════════════════════════════════════════════════

FROM openrfstack-pi4:latest

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-numpy python3-qpid-proton python3-psycopg2 \
    && rm -rf /var/lib/apt/lists/*

COPY AcquisitionApp/src/sdr_recon.py /usr/local/bin/sdr_recon.py
RUN chmod +x /usr/local/bin/sdr_recon.py && \
    mkdir -p /recon && chown sdr:sdr /recon

ENV ENABLE_RECON=1
ENV RECON_OUT=/recon
ENV RECON_SNR_MIN=15
ENV RECON_CAPTURE_S=10
ENV RECON_GAIN=40
ENV RECON_COOLDOWN=60
ENV RECON_FORMAT=cf32
